{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Catalogue",
  "description": "Versioned exercise distribution. Published collections contain only published records; preview may contain both statuses. Empty collections are valid. Record and domain validation still apply.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "channel", "license", "exercises"],
  "properties": {
    "schemaVersion": {
      "$ref": "exercise.schema.json#/properties/schemaVersion"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "pattern": "\\s"
      }
    },
    "channel": {
      "enum": ["published", "preview"]
    },
    "license": {
      "$ref": "exercise.schema.json#/properties/license"
    },
    "exercises": {
      "type": "array",
      "items": {
        "$ref": "exercise.schema.json"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "channel": {
            "const": "published"
          }
        }
      },
      "then": {
        "properties": {
          "exercises": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "published"
                }
              }
            }
          }
        }
      }
    }
  ]
}
