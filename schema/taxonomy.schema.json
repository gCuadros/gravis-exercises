{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Taxonomy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "groups"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "groups": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disciplines", "equipment", "muscles", "families", "metrics"],
      "properties": {
        "disciplines": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/term"
          }
        },
        "equipment": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/term"
          }
        },
        "muscles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/term"
          }
        },
        "families": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/term"
          }
        },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/term"
          }
        }
      }
    }
  },
  "$defs": {
    "bilingual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "es"],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "es": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labels", "definition", "aliases"],
      "properties": {
        "labels": {
          "$ref": "#/$defs/bilingual"
        },
        "definition": {
          "$ref": "#/$defs/bilingual"
        },
        "aliases": {
          "type": "object",
          "additionalProperties": false,
          "required": ["en", "es"],
          "properties": {
            "en": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            },
            "es": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              }
            }
          }
        }
      }
    }
  }
}
