{
  "name": "gravis-exercises",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Open, bilingual exercise data and framework-independent utilities for strength, calisthenics and functional training.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "validate": "node scripts/validate.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "node --test tests/*.test.mjs",
    "test:types": "tsc --project tests/types/tsconfig.json",
    "test:package": "node scripts/check-package.mjs",
    "test:e2e": "playwright test",
    "build": "node scripts/build.mjs",
    "check": "npm run format:check && npm run lint && npm run validate && npm test && npm run build && npm run test:types && npm run test:package",
    "dev": "npm run build && node scripts/serve.mjs",
    "preview": "node scripts/serve.mjs",
    "prepack": "npm run build",
    "taxonomy:sync": "node scripts/sync-taxonomy.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gCuadros/gravis-exercises.git"
  },
  "homepage": "https://github.com/gCuadros/gravis-exercises#readme",
  "bugs": {
    "url": "https://github.com/gCuadros/gravis-exercises/issues"
  },
  "keywords": [
    "exercise",
    "fitness",
    "calisthenics",
    "dataset"
  ],
  "sideEffects": false,
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "default": "./dist/package/index.js"
    },
    "./preview": {
      "types": "./dist/package/preview.d.ts",
      "default": "./dist/package/preview.js"
    },
    "./data": "./dist/package/catalogue.published.json",
    "./data/preview": "./dist/package/catalogue.preview.json",
    "./schema": "./dist/package/exercise.schema.json",
    "./package.json": "./package.json",
    "./taxonomy": {
      "types": "./dist/package/taxonomy.d.ts",
      "default": "./dist/package/taxonomy.js"
    },
    "./taxonomy/data": "./dist/package/taxonomy.json",
    "./taxonomy/schema": "./dist/package/taxonomy.schema.json"
  },
  "files": [
    "dist/package/",
    "LICENSE",
    "README.md"
  ]
}
