{
  "name": "gravis-exercises",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Open, bilingual exercise data and framework-independent utilities for strength, calisthenics and functional training.",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "validate": "node --experimental-strip-types scripts/validate.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:types": "tsc --project tests/types/tsconfig.json",
    "test:package": "node --experimental-strip-types scripts/check-package.ts",
    "test:e2e": "playwright test",
    "build": "pnpm run generate:types && tsc --project tsconfig.runtime.json && node --experimental-strip-types scripts/build.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run validate && pnpm test && pnpm run build && pnpm run test:types && pnpm run test:package",
    "dev": "pnpm run build && node --experimental-strip-types scripts/serve.ts",
    "preview": "node --experimental-strip-types scripts/serve.ts",
    "prepack": "pnpm run build",
    "taxonomy:sync": "node --experimental-strip-types scripts/sync-taxonomy.ts",
    "review:prepare": "node --experimental-strip-types scripts/review-packet.ts prepare",
    "review:verify": "node --experimental-strip-types scripts/review-packet.ts verify",
    "generate:types": "node --experimental-strip-types scripts/generate-types.ts",
    "typecheck": "pnpm run generate:types && tsc --project tsconfig.json"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-schema-to-typescript": "16.0.0",
    "oxlint": "1.89.0",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gCuadros/gravis-exercises.git"
  },
  "homepage": "https://github.com/gCuadros/gravis-exercises#readme",
  "bugs": {
    "url": "https://github.com/gCuadros/gravis-exercises/issues"
  },
  "keywords": [
    "exercise",
    "fitness",
    "calisthenics",
    "dataset"
  ],
  "sideEffects": false,
  "types": "./dist/package/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/package/index.d.ts",
      "default": "./dist/package/index.js"
    },
    "./preview": {
      "types": "./dist/package/preview.d.ts",
      "default": "./dist/package/preview.js"
    },
    "./data": "./dist/package/catalogue.published.json",
    "./data/preview": "./dist/package/catalogue.preview.json",
    "./schema": "./dist/package/exercise.schema.json",
    "./package.json": "./package.json",
    "./taxonomy": {
      "types": "./dist/package/taxonomy.d.ts",
      "default": "./dist/package/taxonomy.js"
    },
    "./taxonomy/data": "./dist/package/taxonomy.json",
    "./taxonomy/schema": "./dist/package/taxonomy.schema.json",
    "./schema/catalogue": "./dist/package/catalogue.schema.json"
  },
  "files": [
    "dist/package/",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "pnpm@12.15.0"
}
